# systemd user service: cp to ~/.config/systemd/user/ then
#   systemctl --user daemon-reload && systemctl --user enable --now scx4500-buttond
# Starts with the graphical session so GUI hooks (Skanpage) can open windows.
# Swap --hook for scan-hook.sh to scan straight to ~/Scans instead.
# (your user must be able to open the USB device, see 99-scx4500.rules)
[Unit]
Description=Samsung SCX-4500 Scan-to-PC button daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/scx4500/scx4500-buttond.py --hook %h/scx4500/open-skanpage.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
